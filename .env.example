# BINGO GAME ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and configure with your credentials

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bingo_db?schema=public"

# Application Port & Node Environment
PORT=3000
NODE_ENV="production"

# Security & Session Secrets
JWT_SECRET="replace_with_strong_random_secret_string_here"
SESSION_SECRET="replace_with_strong_random_session_secret_here"

# Feature Flags
ENABLE_DB_PERSISTENCE=true
RATE_LIMIT_MAX_PER_MINUTE=60
