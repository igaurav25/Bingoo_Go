# BINGO GAME ENVIRONMENT CONFIGURATION
# Production-ready PostgreSQL connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bingo_db?schema=public"

# Application Port & Node Environment
PORT=3000
NODE_ENV="development"

# Security & Session Secrets
JWT_SECRET="bingo_super_secret_jwt_key_2026_dev_prod"
SESSION_SECRET="bingo_session_secure_vault_token_999"

# Feature Flags
ENABLE_DB_PERSISTENCE=true
RATE_LIMIT_MAX_PER_MINUTE=60
