{
  "name": "bingoo_goo",
  "version": "1.0.0",
  "description": "Classic notebook-style Bingo line-cutting system",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "build:verify": "node build.js --verify",
    "prestart": "npm run build",
    "start": "node server/server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test test/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed.js",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "bingo",
    "multiplayer",
    "realtime",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "esbuild": "^0.24.2",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-native": "^0.72.8",
    "typescript": "^7.0.2"
  }
}
